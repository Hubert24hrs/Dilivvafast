# Dilivvafast — CLIENT environment variables
# Copy this file to .env and fill in your values.
#
# ---------------------------------------------------------------------------
# IMPORTANT: everything in .env is bundled into the shipped app as an asset.
# Anyone can unzip an APK/IPA and read it. Only PUBLIC, publishable values
# belong in this file.
#
# Secret-tier credentials are NOT configured here. They live in Cloud Secret
# Manager and are read only by Cloud Functions:
#
#   firebase functions:secrets:set ANTHROPIC_API_KEY
#
# The Google Maps key is NOT here either: Android reads it at build time from
# MAPS_API_KEY in android/local.properties (git-ignored).
#
# See SECURITY.md, "Secret management".
# ---------------------------------------------------------------------------

# ==================== APP CONFIG ====================
APP_ENV=development
API_BASE_URL=https://api.dilivvafast.ng
