# Dilivvafast — local development configuration
#
# Copy to `.env` for local runs. This file is NOT bundled into the app: it is
# gitignored and is not declared as a Flutter asset. Production and CI builds
# pass these values with --dart-define instead. See BUILD.md.
#
# Only client-safe values belong here. Server secrets (Paystack secret key,
# Anthropic API key, SMTP password) live in Firebase Cloud Functions secrets
# and have no accessor anywhere in lib/.

# ==================== MAPBOX ====================
# Publishable token (pk.*). Without it the app runs but maps stay blank.
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# ==================== PAYSTACK ====================
# Publishable key only. Checkout is initialised by the
# initializePaystackPayment Cloud Function, which holds the secret key.
PAYSTACK_PUBLIC_KEY=pk_test_your_key_here

# ==================== APP ====================
APP_ENV=development
API_BASE_URL=https://api.dilivvafast.ng
