rules_version = '2';

// Dilivvafast Firestore security rules.
//
// Guiding rule: anything that represents money, trust, or privilege is written
// by server code only. Clients may write the facts they own (their profile,
// their order request, their rating) and nothing else.
//
// ⚠️ REVIEW BEFORE DEPLOY — see SECURITY.md.

service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== HELPER FUNCTIONS ====================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function callerDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && callerDoc().role == 'admin';
    }

    function isDriver() {
      return isAuthenticated() && callerDoc().role == 'driver';
    }

    // A driver may only work once an admin has approved their application.
    // The role alone is not enough — approval sets isVerifiedDriver, and
    // suspension clears it.
    function isVerifiedDriver() {
      return isDriver() && callerDoc().isVerifiedDriver == true;
    }

    // Keys changed by this write.
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ==================== USERS ====================

    // A new account may declare a wallet, but only an empty one. Money is
    // added exclusively by server code (Paystack verification, payouts,
    // referral bonuses).
    function walletStartsEmpty(data) {
      return !data.keys().hasAny(['walletBalance']) || data.walletBalance == 0;
    }

    // Figures the server owns. A client may never write these itself.
    function noServerOwnedFields(data) {
      return !data.keys().hasAny([
        'averageRating', 'totalRatings', 'isVerifiedDriver'
      ]);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Sign-up. A new account is always a customer: any other role —
      // including 'driver' and 'admin' — must come from privileged server
      // code, so a client cannot mint itself elevated access.
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.role == 'customer'
        && walletStartsEmpty(request.resource.data)
        && noServerOwnedFields(request.resource.data);

      // Profile edits. Role, wallet, and rating counters stay untouchable, and
      // only an approved driver may put themselves on duty.
      allow update: if isOwner(userId)
        && !changed().hasAny([
          'role', 'walletBalance', 'averageRating', 'totalRatings',
          'isVerifiedDriver'
        ])
        && (!changed().hasAny(['isOnline', 'isAvailable']) || isVerifiedDriver());

      match /notifications/{notificationId} {
        allow read, update: if isOwner(userId);
        allow create: if isAuthenticated();
      }

      match /weekly_reports/{reportId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false; // Generated by weeklyDriverReport
      }

      match /saved_addresses/{addressId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      // Card references only — Paystack holds the actual card details, so
      // nothing here is a PAN.
      match /payment_methods/{methodId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    // ==================== ORDERS ====================

    // Fields a driver may touch while working a delivery. Money fields are
    // absent on purpose.
    function driverWritableKeys() {
      return [
        'status', 'updatedAt', 'pickedUpAt', 'deliveredAt',
        'proofOfDeliveryUrl', 'driverLocation', 'driverLocationUpdatedAt'
      ];
    }

    // Support conversations are stored as orders/support_<uid> with a messages
    // subcollection. Scoped to the owner: the previous rule matched any
    // `support_*` id for any signed-in user, which let anyone read anyone
    // else's support thread.
    function isOwnSupportThread(orderId) {
      return isAuthenticated() && orderId == 'support_' + request.auth.uid;
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        isOwnSupportThread(orderId) ||
        resource.data.userId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        isAdmin()
      );

      // Booking. The client proposes a delivery; it does not get to price it.
      // onOrderCreated recomputes totalFare, driverEarnings, and the platform
      // commission from zone config and writes the authoritative values, so
      // whatever the client submits for those is overwritten. The order must
      // start unassigned and unpaid.
      // The order must start unassigned. The app serialises every field, so
      // driverId is present-but-null on create rather than absent — both are
      // accepted, a non-null value is not.
      allow create: if isOwnSupportThread(orderId) || (
        isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.get('driverId', null) == null
        && request.resource.data.paymentStatus == 'pending'
      );

      allow update: if isAuthenticated() && (
        isOwnSupportThread(orderId)
        ||
        // An approved driver claiming an unassigned order. They may only put
        // their own uid in driverId, and only on a pending order.
        (
          isVerifiedDriver()
          && resource.data.status == 'pending'
          && resource.data.get('driverId', null) == null
          && request.resource.data.driverId == request.auth.uid
          && request.resource.data.status == 'accepted'
          && changed().hasOnly(['driverId', 'status', 'updatedAt'])
        )
        ||
        // The assigned driver progressing their own delivery. Cannot touch
        // price, cannot reassign the order.
        (
          resource.data.driverId == request.auth.uid
          && isVerifiedDriver()
          && changed().hasOnly(driverWritableKeys())
        )
        ||
        // The customer rating a completed delivery. Cancellation is NOT here:
        // it goes through the cancelOrder Cloud Function so the refund is
        // actually paid out.
        (
          resource.data.userId == request.auth.uid
          && changed().hasOnly(['rating', 'ratingComment', 'updatedAt'])
        )
        ||
        isAdmin()
      );

      allow delete: if isAdmin();

      match /messages/{messageId} {
        function order() {
          return get(/databases/$(database)/documents/orders/$(orderId)).data;
        }
        function isParticipant() {
          return isAuthenticated() && (
            isOwnSupportThread(orderId) ||
            order().userId == request.auth.uid ||
            order().driverId == request.auth.uid ||
            isAdmin()
          );
        }

        allow read: if isParticipant();
        // Senders can only speak as themselves.
        allow create: if isParticipant()
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ==================== TRANSACTIONS ====================

    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      // Every credit and debit is written by Cloud Functions.
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // ==================== BIKES ====================

    match /bikes/{bikeId} {
      allow read: if isAuthenticated() && (
        resource.data.investorId == request.auth.uid || isAdmin()
      );
      allow create, update, delete: if isAdmin();
    }

    // ==================== ZONES & PROMOS ====================

    match /zones/{zoneId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /promos/{promoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ==================== DRIVER APPLICATIONS ====================

    match /driver_applications/{applicationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      // Applicants submit for themselves, never pre-approved. Approving your
      // own application would be approving your own role.
      // ApplicationStatus.submitted is what the app writes.
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'submitted';

      // Applicants may amend their own documents while still under review.
      allow update: if isAdmin() || (
        isOwner(resource.data.userId)
        && resource.data.status in ['submitted', 'under_review']
        && !changed().hasAny(['status', 'userId', 'reviewedBy', 'reviewedAt'])
      );

      allow delete: if isAdmin();
    }

    // ==================== HP AGREEMENTS ====================

    match /hp_agreements/{agreementId} {
      allow read: if isAuthenticated() && (
        resource.data.investorId == request.auth.uid ||
        resource.data.riderId == request.auth.uid ||
        isAdmin()
      );
      allow create, update, delete: if isAdmin();
    }

    // ==================== RATINGS ====================

    match /ratings/{ratingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      // Immutable: onRatingCreated recomputes driver averages from these.
      allow update, delete: if false;
    }

    // ==================== REFERRALS ====================

    match /referrals/{referralId} {
      allow read: if isAuthenticated() && (
        resource.data.refereeId == request.auth.uid ||
        resource.data.referrerId == request.auth.uid ||
        isAdmin()
      );

      // A user may only record that *they* were referred, and only as pending.
      // referrerId is resolved server-side from the code — a client that could
      // set it would be able to mint ₦500 bonuses for arbitrary accounts.
      allow create: if isAuthenticated()
        && request.resource.data.refereeId == request.auth.uid
        && request.resource.data.status == 'pending'
        && !request.resource.data.keys().hasAny(['referrerId']);

      // Completion (and the payout it triggers) is server-side only.
      allow update, delete: if false;
    }

    // ==================== SOS ALERTS ====================

    match /sos_alerts/{alertId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'active';
      // Only an admin closes an alert.
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ==================== CATCH-ALL ====================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
